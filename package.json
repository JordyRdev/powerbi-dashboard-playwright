{
  "name": "powerbi-playwright-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test suite whose CI results feed a star schema and a Power BI quality dashboard.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=visual",
    "test:chromium": "playwright test --project=api --project=chromium",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:pipeline",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --config allurerc.mjs --clean && allure open allure-report",
    "docker:build": "docker build -t powerbi-playwright-dashboard .",
    "docker:test": "docker run --rm --ipc=host -v \"$PWD/playwright-report:/app/playwright-report\" -v \"$PWD/test-results:/app/test-results\" powerbi-playwright-dashboard",
    "docker:update-snapshots": "docker run --rm --ipc=host -v \"$PWD/tests/visual:/app/tests/visual\" powerbi-playwright-dashboard npx playwright test --project=visual --update-snapshots=all",
    "test:pipeline": "tsx --test pipeline/tests/*.test.ts",
    "data:ingest": "tsx pipeline/ingest.ts",
    "data:build": "tsx pipeline/build.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.21.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "zod": "^4.6.7"
  }
}
