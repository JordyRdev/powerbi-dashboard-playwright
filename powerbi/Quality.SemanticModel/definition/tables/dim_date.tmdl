/// One calendar day (UTC), with no gaps between the first and last run.
table dim_date
	lineageTag: 0225cdeb-89c9-4969-b6f3-4cd7b7d7ea1d
	dataCategory: Time

	/// Date key in yyyymmdd form. Hidden. The relationship uses this column.
	column date_key
		dataType: int64
		isHidden
		displayFolder: Keys
		lineageTag: abbb585e-eb0b-40e5-85a3-8ede2dccb77d
		summarizeBy: none
		sourceColumn: date_key

	/// Calendar date (UTC). This is the marked date column.
	column Date
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		displayFolder: Calendar
		lineageTag: 7f23edcc-e65e-466d-937e-cf5d9d925dfa
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		displayFolder: Calendar
		lineageTag: 13da41cf-6431-403d-b09e-4e41fb6194d4
		summarizeBy: none
		sourceColumn: year

	/// Month number. Hidden. Sorts Month.
	column 'Month number'
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Calendar
		lineageTag: 4fd31926-6128-4a58-a312-dbc824bb82b2
		summarizeBy: none
		sourceColumn: month

	column Month
		dataType: string
		displayFolder: Calendar
		lineageTag: c9bb4f4c-580b-4695-a1ab-19c537c352d1
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: 'Month number'

	column 'Year month'
		dataType: string
		displayFolder: Calendar
		lineageTag: d08bed88-7002-4b96-8048-45b2d1319e00
		summarizeBy: none
		sourceColumn: year_month

	column 'ISO week'
		dataType: int64
		formatString: 0
		displayFolder: Calendar
		lineageTag: 20f83a40-42cf-4adb-91d0-3ea673f12924
		summarizeBy: none
		sourceColumn: iso_year_week

	/// ISO weekday number. Hidden. Sorts Weekday.
	column 'Weekday number'
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: Calendar
		lineageTag: 33aacf3d-0207-4a6e-9f76-43212a62f161
		summarizeBy: none
		sourceColumn: weekday

	column Weekday
		dataType: string
		displayFolder: Calendar
		lineageTag: 1ab619b6-4e2e-40df-b1d6-336e4395bcc8
		summarizeBy: none
		sourceColumn: weekday_name
		sortByColumn: 'Weekday number'

	column Weekend
		dataType: boolean
		displayFolder: Calendar
		lineageTag: 5f2b1149-3428-480f-9d11-b325d2022165
		summarizeBy: none
		sourceColumn: is_weekend

	partition dim_date = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("dim_date.csv"),
				    Typed = Table.TransformColumnTypes(
				        Source,
				        {
				            {"date_key", Int64.Type},
				            {"date", type text},
				            {"year", Int64.Type},
				            {"month", Int64.Type},
				            {"month_name", type text},
				            {"year_month", type text},
				            {"iso_year_week", Int64.Type},
				            {"weekday", Int64.Type},
				            {"weekday_name", type text},
				            {"is_weekend", type logical}
				        }
				    ),
				    Parsed = Table.TransformColumns(
				        Typed,
				        {
				            {"date", each fnAsDate(_), type date}
				        }
				    )
				in
				    Parsed

